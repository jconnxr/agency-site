# Intake + contact form delivery (POST /api/intake). Server-only: no NEXT_PUBLIC_ prefix.
# Resend API key (resend.com -> API Keys)
RESEND_API_KEY=
# Where lead notifications go. Comma-separate for more than one address.
NOTIFY_EMAIL=
# Sender, on a domain verified in Resend. Defaults to onboarding@resend.dev,
# which only delivers to the Resend account's own email.
RESEND_FROM="Axiom Intake <leads@axiommediagroupokc.com>"
# Optional: every submission is also POSTed here as JSON
CRM_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>" to the CRM webhook
CRM_WEBHOOK_SECRET=
